@startuml logical-data
title Логическая схема данных. УЛО
hide circle
skinparam shadowing false

entity "Организация" as Org {
  * наименование
  --
  признак поставщика
}

entity "Пользователь" as User {
  * логин
  --
  ФИО, должность, e-mail
}

entity "Роль" as Role {
  * название роли
  --
  набор действий
}

entity "Сбор" as Collection {
  * название и период
  --
  финансовый лимит
  допустимые категории
}

entity "Номенклатура" as Catalog {
  * название
  --
  набор свойств товаров
}

entity "Товар" as Product {
  * название в номенклатуре
  --
  категория
  цена, остаток (если есть)
}

entity "Заявка" as Request {
  * номер
  --
  вид: обычная / сводная
  статус, номер версии
  общая стоимость
}

entity "Позиция заявки" as Item {
  * заявка + товар
  --
  количество
  цена на момент включения
}

entity "Решение по заявке" as Decision {
  * заявка + момент решения
  --
  вид решения
  комментарий
}

entity "Уведомление" as Notice {
  * получатель + время
  --
  событие, канал
  результат доставки
}

entity "Запись истории" as Log {
  * объект + дата и время
  --
  действие
  состав объекта на момент действия
}

Org |o--o{ Org : состоит из
Org ||--o{ User : сотрудники
User }o--o{ Role : имеет
Org ||--o{ Collection : открывает
Collection |o--o{ Collection : локальный срок\nвнутри родительского
Org ||--o{ Catalog : ведет
Catalog ||--o{ Product : содержит
Org ||--o{ Request : подает
User ||--o{ Request : создает
Collection ||--o{ Request : в рамках
Request ||--o{ Item : состоит из
Product ||--o{ Item : выбран в
Request ||--o{ Decision : получает
User ||--o{ Decision : принимает
Request }o--o| Request : входит в сводную
User ||--o{ Notice : получает
User ||--o{ Log : совершает

note bottom of Request
  Прежний состав заявки при каждой
  отправке сохраняется в записи истории.
end note
@enduml
